# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build
/dist

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# env files (DO NOT COMMIT)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Keep .env.example for reference
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDEs
.vscode/*
!.vscode/extensions.json
.idea
*.swp
*.swo
*~
.DS_Store

# SSH Keys (NEVER COMMIT)
*.pem
*.key
id_rsa*
*.ppk

# Database dumps
*.sql
*.dump

# PM2
.pm2/
pids/
*.pid
*.seed
*.pid.lock

# Logs
logs/
*.log

# Claude Code (personal settings)
.claude/

# Personal configs
ecosystem.config.js
