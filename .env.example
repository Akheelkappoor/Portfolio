# Admin Password
ADMIN_PASSWORD=your_secure_password_here

# Vercel Blob Storage (Optional)
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# Gmail SMTP Configuration (for contact form)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
CONTACT_FROM_EMAIL=your_email@gmail.com
CONTACT_TO_EMAIL=recipient@example.com

# AWS Configuration
AWS_REGION=me-central-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET=your-s3-bucket-name
S3_PUBLIC_BASE_URL=https://your-bucket.s3.region.amazonaws.com/folder/

# Database Configuration
# For local development (with SSH tunnel):
DATABASE_URL=postgres://username:password@localhost:5432/portfolio

# For production (EC2 direct connection to RDS):
# DATABASE_URL=postgres://username:password@your-rds-endpoint.region.rds.amazonaws.com:5432/portfolio?sslmode=require

# Database Credentials
Master_username=your_db_username
password_forsql=your_db_password

# EC2 Instance Public IP (for reference)
publicip=your_ec2_public_ip
