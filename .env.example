# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string
# Examples:
# - AWS RDS: postgresql://postgres:password@your-db.region.rds.amazonaws.com:5432/portfolio
# - Neon: postgresql://user:password@ep-xxx.region.aws.neon.tech/portfolio
# - Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
# - Local: postgresql://postgres:password@localhost:5432/portfolio

DATABASE_URL=postgresql://username:password@host:5432/portfolio

# ============================================
# AWS S3 (For Image & File Uploads)
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET=your-s3-bucket-name
S3_PUBLIC_BASE_URL=https://your-bucket.s3.us-east-1.amazonaws.com

# ============================================
# EMAIL CONFIGURATION (Optional - Can configure in admin panel)
# ============================================
# You can either:
# 1. Set these environment variables (legacy method)
# 2. Configure in admin panel at /admin/settings -> Email tab (recommended)

# Gmail SMTP (most common)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
CONTACT_FROM_EMAIL=your-email@gmail.com
CONTACT_TO_EMAIL=recipient@example.com

# OR use custom SMTP (configure in admin panel)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password

# ============================================
# SECURITY & ENCRYPTION
# ============================================
# Generate a random 32-character string for encrypting passwords stored in database
# On Mac/Linux: openssl rand -base64 24
# On Windows PowerShell: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})

ENCRYPTION_KEY=your-random-32-character-secret-key-here

# ============================================
# ADMIN PASSWORD (Optional)
# ============================================
# You can either:
# 1. Set via Setup Wizard (recommended for first-time users)
# 2. Set this environment variable (for existing setups)

# ADMIN_PASSWORD=your_secure_password_here

# ============================================
# OPTIONAL: AI CHATBOT (N8N)
# ============================================
# Only needed if you're setting up the AI chatbot feature
# See N8N_CHATBOT_SETUP.md for complete setup instructions

# NEXT_PUBLIC_CHATBOT_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/chatbot

# ============================================
# OPTIONAL: Vercel Blob Storage
# ============================================
# Alternative to AWS S3 if deploying to Vercel
# Not required if using AWS S3

# BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# ============================================
# OPTIONAL: Production Settings
# ============================================
# NODE_ENV=production
